# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# SUMO / experiment outputs that are regenerated by the scripts.
#
# The route files and the compiled network are NOT ignored: they are small,
# and committing them means a reader can reproduce the exact traffic we
# measured without having to trust that their SUMO version generates the same
# thing ours did.
results/tripinfo/
*.sumocfg.tmp

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tool caches
.pytest_cache/
.ruff_cache/

# Corridor: raw per-vehicle SUMO output, regenerated by the evaluation.
results/corridor/tripinfo/
